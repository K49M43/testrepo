  "decimal_context": {
    "decimal_precision": 50,
    "decimal_rounding": "ROUND_HALF_EVEN"
  },
  "method": {
    "nominal_equation": "FV(r,n) = initial*(1+r)^n + sum(contribution_m*(1+r)^(n-m)); solve FV = real_target*(1+inflation)^(n/12)",
    "real_equation": "Deflate each dated contribution by (1+inflation)^(m/12), then independently solve FV(real_r,n) = real_target",
    "annualization": "effective annual return = (1+monthly return)^12 - 1",
    "hurdle_sensitivity": "implicit derivative d(r_annual)/d(target) = 12*(1+r_monthly)^11 / d(FV)/d(r_monthly)",
    "cpi_sensitivity": "chain rule: d(target_nominal)/d(inflation) = target_nominal*(n/12)/(1+inflation)"
  },
  "limitations": {
    "included": [
      "constant monthly gross return needed to reach the nominalized target under the illustrative dated cashflows",
      "equivalent effective annual nominal return",
      "equivalent effective annual real return under each CPI scenario",
      "independent solution in real purchasing-power cashflows",
      "local derivatives of required hurdle versus target and CPI assumption"
    ],
    "excluded": [
      "taxes, fees, spreads, and other costs",
      "instrument availability, eligibility, and return feasibility",
      "return volatility, sequence risk, probability, confidence intervals, and model uncertainty",
      "investor-specific outcome or recommendation"
    ],
    "interpretation": "pre-tax/pre-cost arithmetic hurdle only; it is not an expected return, sufficient after-tax hurdle, or likelihood estimate",
    "after_tax_hurdle_status": "requires strategy-specific instrument, cashflow, tax, fee, and exit-policy paths; no single investor-specific hurdle is asserted here"
  },
